# Copy to .env (local) or .env.docker (compose) and fill in. Never commit real values.

PORT=8000
NODE_ENV=development

DATABASE_URL=postgresql://nstx_user:change_me@localhost:5432/nstx_db?schema=public

# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# From @BotFather
TELEGRAM_BOT_TOKEN=000000000:replace_with_your_bot_token
TELEGRAM_BOT_USERNAME=YourBotName
# Required in production: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=true
TELEGRAM_POLL_INTERVAL_MS=1500

# Optional: password reset emails are disabled without it
SENDGRID_API_KEY=

CORS_ORIGIN=http://localhost:3000
